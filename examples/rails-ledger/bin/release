#!/usr/bin/env ruby
# The sole production migration entrypoint; neither web nor worker boot migrates.
ENV["RAILS_ENV"] ||= "production"
require_relative "../config/environment"

attempts = Integer(ENV.fetch("RELEASE_DB_ATTEMPTS", "15"))
abort "RELEASE_DB_ATTEMPTS must be between 1 and 60" unless (1..60).cover?(attempts)

attempts.times do |attempt|
  begin
    ActiveRecord::Base.connection_pool.with_connection { |connection| connection.select_value("SELECT 1") }
    break
  rescue ActiveRecord::ConnectionNotEstablished, ActiveRecord::NoDatabaseError, ActiveRecord::StatementInvalid
    # Never print connection options/passwords. Each connection has a 3s timeout.
    abort "Database unavailable after #{attempts} attempts; migrations not run" if attempt + 1 == attempts
    warn "Waiting for database (#{attempt + 1}/#{attempts})"
    sleep 1
  end
end

ActiveRecord::Base.connection_pool.disconnect!
# Exactly one attempt; exec preserves migration status and signals. No rescue/retry here.
exec File.expand_path("rails", __dir__), "db:migrate"
